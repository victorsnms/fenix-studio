{
  "images": {
    "ServicesGalleryImages": [
      {
        "path": "services/Comp_EN.png",
        "alt": "Compositing",
        "title": "Compositing",
        "text": "Merging two or more images/video/elements into a single product. Within our compositing process we offer solutions in Keying (Greenscreen & Bluescreen), Rotoscope, Color Correction, Clean-up of Elements in 2D & 3D, Integration of Effects or diverse footages, 3D Projection, Beauty/Digital Make-up and Set Extensions."
      },
      {
        "path": "services/MattePainting_PTEN.png",
        "alt": "Matte Painting",
        "title": "Matte Painting",
        "text": "Digital creation of set extensions to be integrated into shots. Solutions in 2D & 3D Matte Painting depending on the project's necessity. We utilize multiple layers in our work for flexible adaptation and changes in the art. Creation based on the Concept Art & Visualization of the shot."
      },
      {
        "path": "services/Visu_EN.png",
        "alt": "Visualization",
        "title": "Visualization",
        "text": "Planning of the Visual Effects to be created and implemented based on the directions of the script/client. Solutions in Look Development with Post Visualization offering a Pre-Comp for a better understanding on the planning of the effects to be finalized/created."
      },
      {
        "path": "services/Sup_EN.png",
        "alt": "Visual Effects Supervision & On-Set",
        "title": "Visual Effects Supervision & On-Set",
        "text": "Guiding technically and artistically the execution of the demands from start to finish. Support on-set on scenes that require visual effects. Optimizing the shoot, capture of elements, measures & necessary information for the execution of the effects."
      },
      {
        "path": "services/3D_PTEN.png",
        "alt": "3D",
        "title": "3D",
        "text": "Creation of objects and characters in 3D. Complete process from Modeling, Texturing, Lighting, Animation & Rendering. Solutions in 3D for shots that need visual effects. Renders with multiple passes to facilitate 3D integration with Compositing workflow."
      },
      {
        "path": "services/Motion_PTEN.png",
        "alt": "Motion Graphics",
        "title": "Motion Graphics",
        "text": "Lettering creation for texts with distinct animations. Creation of artistic elements, visual effects & animation of 2D characters to be used on shots based on the necessities of each individual project."
      },
      {
        "path": "services/Match_PTEN.png",
        "alt": "MatchMove",
        "title": "MatchMove",
        "text": "Movement tracking of camera and/or objects in a scene. With the help of matchmove we can integrate 3D characters and objects into a shot with movement taking into account alterations in parallax and perspective."
      },
      {
        "path": "services/MattePainting_PTEN.png",
        "alt": "Virtual Production",
        "title": "Virtual Production",
        "text": "Leveraging real-time technologies to create immersive and interactive filmmaking experiences. Our Virtual Production services encompass technologies like LED volumes, real-time engines, and in-camera VFX to enhance creativity and streamline production workflows."
      },
      {
        "path": "services/MattePainting_PTEN.png",
        "alt": "FOOH",
        "title": "FOOH",
        "text": "Create realistic simulations of Out-of-Home (OOH) advertising campaigns. We use advanced 3D rendering and compositing techniques to place digital billboards, posters, and other OOH elements seamlessly into real-world environments. FOOH allows clients to test and refine OOH campaigns before actual implementation, optimizing their impact and ROI."
      }
    ],
